{
  "name": "club-schedule",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write src server functions tests scripts package.json tsconfig.json vite.config.ts eslint.config.js index.html",
    "format:check": "prettier --check src server functions tests scripts package.json tsconfig.json vite.config.ts eslint.config.js index.html",
    "test": "vitest run --configLoader runner",
    "db:local": "wrangler d1 migrations apply club-schedule-dev --local",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.33.0"
  }
}
